# SENTINEL VOICE — Environment Configuration
# Copy this file to .env before starting the services

# Rime TTS Configuration
RIME_API_KEY=
RIME_MODEL=mist
RIME_SPEAKER=amber
RIME_LANGUAGE=en
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_AUDIO_FORMAT=wav
RIME_SAMPLE_RATE=22050
RIME_TRANSPORT=http_chunked

# LLM Reasoning Configuration (Optional - falls back to high-speed SmartIntentEngine)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# STT Configuration (Optional - browser WebSpeech & simulated fallbacks available)
STT_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_ENDPOINT=https://api.deepgram.com/v1/listen

# Realtime & LiveKit (Optional)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Database & Cache (Optional - in-memory storage runs by default)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel_db

# Engine Parameters
TOOL_DELAY_MS=3500
INTERRUPTION_THRESHOLD=0.65
DEMO_MODE=false
